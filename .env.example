# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Conversational RAG & Interview Booking API
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Relational database (metadata + interview bookings)
# Local zero-friction default: SQLite. Docker Compose overrides this with Postgres.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_ECHO=false
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ---------------------------------------------------------------------------
# Redis (chat memory)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_TTL_SECONDS=86400
CHAT_HISTORY_MAX_MESSAGES=20

# ---------------------------------------------------------------------------
# Qdrant (vector store)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Leave empty for a local, unauthenticated Qdrant instance.
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
EMBEDDING_DIMENSION=1536

# ---------------------------------------------------------------------------
# LLM & embeddings (any OpenAI-compatible provider: OpenAI / Gemini / Mistral / Ollama)
# ---------------------------------------------------------------------------
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# Retrieval
RAG_TOP_K=5

# Google Gemini (free tier, if the Google Cloud project is eligible):
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=3072
#
# Local Ollama (free, no account; API runs in Docker, Ollama on the host):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2:3b
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
