{
  "info": {
    "name": "Conversational RAG Backend - Phases 1-4",
    "description": "Phase 1: liveness + OpenAPI. Phase 3: POST /api/v1/ingest (multipart PDF/TXT ingestion). Phase 4: POST /api/v1/chat (Redis memory + Qdrant retrieval + grounded answers). Ingest sample.txt first, then run the two chat requests in order to exercise multi-turn memory. The ingest requests reference sample.txt in this folder; if Postman cannot resolve it, pick the file manually in the request body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": "postman-demo-session"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness probe. Expects 200 and status=ok."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('body reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('has version', () => pm.expect(pm.response.json().version).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI schema",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.json",
          "host": ["{{baseUrl}}"],
          "path": ["openapi.json"]
        },
        "description": "Machine-readable OpenAPI schema. Useful to confirm registered routes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('schema has paths', () => pm.expect(pm.response.json().paths).to.be.an('object'));",
              "pm.test('ingest route is registered', () => pm.expect(pm.response.json().paths).to.have.property('/api/v1/ingest'));",
              "pm.test('chat route is registered', () => pm.expect(pm.response.json().paths).to.have.property('/api/v1/chat'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Swagger UI (HTML)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/docs",
          "host": ["{{baseUrl}}"],
          "path": ["docs"]
        },
        "description": "Interactive docs. Open this URL in a browser for the best experience; Postman will show raw HTML."
      }
    },
    {
      "name": "Ingest TXT (semantic)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample.txt",
              "description": "PDF (.pdf) or plain text (.txt). Maximum MAX_UPLOAD_BYTES (10 MiB by default)."
            },
            {
              "key": "chunking_strategy",
              "value": "semantic",
              "type": "text",
              "description": "fixed | semantic. Defaults to semantic."
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ingest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ingest"]
        },
        "description": "Extracts text, chunks it, embeds the chunks, upserts vectors into Qdrant, and persists metadata in SQL. Requires a valid LLM_API_KEY (or an OpenAI-compatible embeddings endpoint) in the API environment."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('document_id is a UUID', () => pm.expect(body.document_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
              "pm.test('filename is returned', () => pm.expect(body.filename).to.be.a('string').and.not.empty);",
              "pm.test('strategy is echoed', () => pm.expect(body.chunking_strategy).to.eql('semantic'));",
              "pm.test('chunks were indexed', () => pm.expect(body.chunks_indexed).to.be.above(0));",
              "pm.collectionVariables.set('documentId', body.document_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest TXT (fixed)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample.txt"
            },
            {
              "key": "chunking_strategy",
              "value": "fixed",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ingest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ingest"]
        },
        "description": "Same pipeline using 500-character windows with 50-character overlap."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('fixed strategy is echoed', () => pm.expect(pm.response.json().chunking_strategy).to.eql('fixed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest unsupported type (400)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample.md"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ingest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ingest"]
        },
        "description": "Negative case: .md is rejected with 400 before any embedding call."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('detail names supported types', () => pm.expect(pm.response.json().detail).to.include('.pdf'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat turn 1 (leave policy)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"message\": \"How many days of paid annual leave do employees get?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat"]
        },
        "description": "First turn: retrieves the top RAG_TOP_K chunks, answers with source attribution, and stores the exchange in Redis under chat:history:{session_id}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('session is echoed', () => pm.expect(body.session_id).to.eql(pm.collectionVariables.get('sessionId')));",
              "pm.test('answer is not empty', () => pm.expect(body.answer).to.be.a('string').and.not.empty);",
              "pm.test('sources are returned', () => pm.expect(body.sources).to.be.an('array').with.length.above(0));",
              "pm.test('source includes attribution', () => pm.expect(body.sources[0]).to.include.keys('document_id', 'filename', 'chunk_index', 'text', 'score'));",
              "pm.test('booking is null before Phase 5', () => pm.expect(body.booking).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat turn 2 (follow-up, tests memory)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"message\": \"And what about remote work - how many days per week are allowed?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat"]
        },
        "description": "Second turn with the same session_id. History exists, so the query is first rewritten into a standalone search query before retrieval."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('same session', () => pm.expect(body.session_id).to.eql(pm.collectionVariables.get('sessionId')));",
              "pm.test('answer is not empty', () => pm.expect(body.answer).to.be.a('string').and.not.empty);",
              "pm.test('sources are returned', () => pm.expect(body.sources).to.be.an('array').with.length.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat blank message (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"message\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat"]
        },
        "description": "Negative case: whitespace-only messages are rejected by the stripped-field validator with 422."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('message field is flagged', () => pm.expect(pm.response.json().detail[0].loc).to.include('message'));"
            ]
          }
        }
      ]
    }
  ]
}
